# Normalize line endings: store LF in the repo, check out native on each OS.
* text=auto eol=lf
# Scripts de Windows: cmd.exe/PowerShell esperan CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.xlsx binary
*.ipynb binary
*.db binary
*.pkl binary

# Kit de marca (2026-11-17): formatos que la normalización de finales de línea podría alterar.
*.eps binary
*.ase binary
*.woff2 binary
*.ttf binary
*.ico binary
*.pdf binary
