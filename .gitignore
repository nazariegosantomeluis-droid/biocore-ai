# ─────────────────────────────────────────────────────────────
# BIOCORE AI — .gitignore
# ─────────────────────────────────────────────────────────────

# ── Python bytecode / caches ────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Test / type / lint caches ───────────────────────────────
.pytest_cache/
.mypy_cache/
.dmypy.json
.ruff_cache/
.cache/
.hypothesis/

# ── Coverage / build / packaging ────────────────────────────
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
nosetests.xml
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
pip-wheel-metadata/

# ── Virtual environments (never commit — 1.3 GB conda env, etc.) ─
.venv/
venv/
env/
ENV/
.conda/
conda-meta/
env.bak/
venv.bak/

# ── Secrets / credentials ──────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
.streamlit/secrets.toml

# ── Editor / OS cruft ──────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.tmp
.idea/
# .vscode/ kept: only holds project-wide Python env-manager settings

# ── Local runtime state / generated databases ──────────────
# Regenerated by the app on first run (UPS, clinical states, rural health).
data/biocore_ups.db
clinical_states.db
rural_health/patient_history.db
*.sqlite
*.sqlite3
data/local/*
!data/local/.gitkeep

# ── Downloaded datasets (large, redownloadable via wfdb / PhysioNet) ─
# PTB-XL metadata + any MIT-BIH / PhysioNet waveform records pulled locally.
data/ptbxl_database.csv
data/mitdb/
data/ptbxl/
data/physionet/
*.dat
*.hea
*.atr
*.edf
*.wfdb

# ── Trained model binaries (regenerated by training scripts) ─
*.pkl
*.joblib
*.h5
*.hdf5
*.onnx
models/*.pkl

# ── Generated pipeline outputs ─────────────────────────────
# main.py (root CLI) writes PNGs to figures/; app/reporting.py writes lab
# reports to reports/; the reasoning engine dumps timestamped JSON.
# Dirs are kept (via .gitkeep) so the app can write into them on a fresh clone.
figures/*
!figures/.gitkeep
reports/*
!reports/.gitkeep
reasoning_output_*.json

# ── Claude Code local session state ───────────────────────
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/projects/

# ── Jupyter ───────────────────────────────────────────────
.ipynb_checkpoints/
